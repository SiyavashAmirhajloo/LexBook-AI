# LLM Provider (V2+)
GEMINI_API_KEY=your-gemini-key

# Embedding Provider
# FastEmbed (local, default): no key needed
# For HuggingFace bge‑m3 embeddings set HF_API_TOKEN below
# For Jina/OpenAI/Gemini embeddings add their keys below
HF_API_TOKEN=your-huggingface-token

# Search Provider (V5)
# DuckDuckGo: no key needed
# For Tavily/Brave/SerpAPI/Google CSE add keys below

# App Config
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/lexbook
EMBEDDING_PROVIDER=fastembed
UPLOAD_DIR=uploads
DEBUG=false